// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  username             String    @unique
  password             String?   // Optional for OAuth users
  displayName          String?
  avatar               String?
  role                 String    @default("client") // client, admin, operator, staff
  isActive             Boolean   @default(false)
  verifyToken          String?
  verifyTokenExpiry    DateTime?
  passwordResetToken   String?   @unique
  passwordResetExpiry  DateTime?

  // Contact & Personal Information
  phoneNumber          String?   @map("phone_number")
  address              String?

  // Financial Information (for refunds)
  bankAccount          String?   @map("bank_account") // Bank account number for refunds
  accountBalance       Decimal   @default(0) @db.Decimal(10, 2) @map("account_balance") // Temporary balance for refunds
  currency             String    @default("VND") // Currency type (VND, USD, etc.)

  // OAuth fields
  oauthProvider        String?   // google, facebook, etc.
  oauthSub             String?   @unique // Auth0 user ID
  isOauthUser          Boolean   @default(false)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relationships
  refreshTokens   RefreshToken[]
  payment_methods PaymentMethod[]
  feedbacks       Feedback[]
  bookings        Booking[]
  staff           Staff?

  @@map("users")
}

model Staff {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  operatorId String?  @map("operator_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relationships
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  trips    Trip[]

  @@map("staff")
}

// Refresh Token for JWT rotation
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  familyId  String    // Token family for rotation detection
  expiresAt DateTime
  isRevoked Boolean   @default(false)
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PaymentMethod {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  provider    String   // stripe, paypal, vnpay, etc.
  token       String   // encrypted token/card details
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationships
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@map("payment_methods")
}

// Operator Management
model Operator {
  id           String    @id @default(uuid())
  name         String
  contactEmail String    @map("contact_email")
  contactPhone String?   @map("contact_phone")
  status       String    @default("pending") // pending, approved, suspended
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relationships
  routes Route[]
  buses  Bus[]
  staff  Staff[]
  trips  Trip[]

  @@map("operators")
}

// Route and Transportation
model Stop {
  id        String   @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  address   String?
  active    Boolean  @default(true)

  // Relations
  originRoutes      Route[] @relation("OriginStop")
  destinationRoutes Route[] @relation("DestinationStop")
  routeStops        RouteStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([latitude, longitude])
  @@map("stops")
}

model Route {
  id                String @id @default(uuid())
  name              String
  operatorId        String @map("operator_id")
  originStopId      String
  destinationStopId String
  distanceKm        Float? @map("distance_km")
  estimatedMinutes  Int?   @map("estimated_minutes")
  active            Boolean @default(true)

  // Relationships
  operator          Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  trips             Trip[]
  originStop        Stop   @relation("OriginStop", fields: [originStopId], references: [id])
  destinationStop   Stop   @relation("DestinationStop", fields: [destinationStopId], references: [id])
  stops             RouteStop[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([active])
  @@index([originStopId, destinationStopId])
  @@map("routes")
}

model RouteStop {
  id        String  @id @default(uuid())
  routeId   String
  stopId    String
  sequence  Int     // order along the route (1..n)
  isPickup  Boolean @default(true)
  isDropoff Boolean @default(true)
  note      String?

  // Relations
  route     Route @relation(fields: [routeId], references: [id])
  stop      Stop  @relation(fields: [stopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routeId, sequence])
  @@unique([routeId, stopId])
  @@index([stopId])
  @@map("route_stops")
}

model Bus {
  id            String   @id @default(uuid())
  operatorId    String   @map("operator_id")
  plateNumber   String   @unique @map("plate_number")
  model         String
  busType       String   @default("Seater") @map("bus_type") // Seater, Sleeper Bus, VIP Cabin Sleeper, Limousine
  seatCapacity  Int      @map("seat_capacity")
  amenities     String?  @map("amenities_json") // JSON string for amenities like WiFi, AC, etc.
  images        String?  @map("images_json") // JSON string array of image URLs
  status        String   @default("active") // active, inactive, maintenance
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relationships
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  seats    Seat[]
  trips    Trip[]

  @@map("buses")
}

model Seat {
  id         String  @id @default(uuid())
  busId      String  @map("bus_id")
  seatNumber String  @map("seat_number")
  seatType   String  @default("regular") @map("seat_type") // regular, premium, sleeper
  isActive   Boolean @default(true) @map("is_active")

  // Relationships
  bus         Bus          @relation(fields: [busId], references: [id], onDelete: Cascade)
  seatStatuses SeatStatus[]

  @@unique([busId, seatNumber])
  @@map("seats")
}

// Trip and Booking Management
model Trip {
  id              String    @id @default(uuid())
  routeId         String    @map("route_id")
  busId           String    @map("bus_id")
  operatorId      String    @map("operator_id")
  staffId         String?   @map("staff_id")
  departureTime   DateTime  @map("departure_time")
  arrivalTime     DateTime  @map("arrival_time")
  actualDeparture DateTime? @map("actual_departure")
  actualArrival   DateTime? @map("actual_arrival")
  basePrice       Decimal   @db.Decimal(10, 2) @map("base_price")
  status          String    @default("scheduled") // scheduled, departed, arrived, completed, cancelled

  // Relationships
  route        Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bus          Bus          @relation(fields: [busId], references: [id], onDelete: Cascade)
  operator     Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  staff        Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  seatStatuses SeatStatus[]
  bookings     Booking[]
  feedbacks    Feedback[]

  @@map("trips")
  @@index([routeId, departureTime])
  @@index([departureTime])
  @@index([basePrice])
  @@index([status])
  @@index([staffId])
  @@index([operatorId])
}

model SeatStatus {
  id          String    @id @default(uuid())
  tripId      String    @map("trip_id")
  seatId      String    @map("seat_id")
  status      String    @default("available") // available, locked, booked
  lockedUntil DateTime? @map("locked_until")

  // Relationships
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seat Seat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatId])
  @@map("seat_statuses")
}

model Booking {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  tripId          String   @map("trip_id")
  status          String   @default("pending") // pending, confirmed, cancelled, completed
  totalAmount     Decimal  @db.Decimal(10, 2) @map("total_amount")
  bookedAt        DateTime @default(now()) @map("booked_at")

  // Relationships
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip            Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payments        Payment[]
  notifications   Notification[]
  passengerDetails PassengerDetail[]
  feedback        Feedback?

  @@map("bookings")
}

model Payment {
  id             String    @id @default(uuid())
  bookingId      String    @map("booking_id")
  provider       String    // stripe, paypal, vnpay, etc.
  transactionRef String?   @unique @map("transaction_ref")
  amount         Decimal   @db.Decimal(10, 2)
  status         String    @default("pending") // pending, completed, failed, refunded
  processedAt    DateTime? @map("processed_at")

  // Relationships
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PassengerDetail {
  id        String    @id @default(uuid())
  bookingId String    @map("booking_id")
  fullName  String    @map("full_name")
  documentId String   @map("document_id")
  seatCode  String    @map("seat_code")
  isBoarded Boolean   @default(false) @map("is_boarded")
  boardedAt DateTime? @map("boarded_at")

  // Relationships
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("passenger_details")
}

// Notification and Feedback
model Notification {
  id              String    @id @default(uuid())
  bookingId       String?   @map("booking_id")
  paymentMethodId String?   @map("payment_method_id")
  channel         String    // email, sms, push
  template        String    // booking_confirmed, payment_received, etc.
  status          String    @default("pending") // pending, sent, failed
  sentAt          DateTime? @map("sent_at")

  // Relationships
  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Feedback {
  id          String   @id @default(uuid())
  bookingId   String   @unique @map("booking_id") // 1 feedback per booking
  tripId      String   @map("trip_id")
  userId      String   @map("user_id")
  rating      Int      // 1-5 stars
  comment     String?
  submittedAt DateTime @default(now()) @map("submitted_at")

  // Relationships
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}
